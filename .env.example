COMPOSE_PROJECT_NAME=pisite
IMAGE_TAG=latest
DOCKER_PLATFORM=linux/arm64

# Bind frontend to 127.0.0.1 when a host reverse proxy such as Nginx/Caddy handles public HTTPS.
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=13000

# Generate strong values before deployment, for example:
# openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
DONOR_JWT_SECRET=replace-with-a-different-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-another-long-random-secret

# false keeps the admin panel usable through the frontend reverse proxy.
# Set true only when admin access comes from an internal network/VPN.
ADMIN_INTERNAL_ONLY=false
